*.swo
*~

# OS
.DS_Store
Thumbs.db

# Large data files - CalAccess raw data (3+ GB)
scraper/data/finance/calaccess_raw/
scraper/data/finance/*.zip
scraper/data/finance/*.db

# Large data files - CalAccess root-level dumps (1.5GB zip, ~50GB extracted)
data/CalAccess/*.zip
data/CalAccess/DUMP_*/
data/CalAccess/DATA/
# But keep small Phase-0 artifacts trackable:
!data/CalAccess/SOURCE_MATRIX.md
!data/CalAccess/v2_pre_v3_baseline.json
!data/CalAccess/ballotpedia_baselines.json
!data/CalAccess/trace_tests.json

# Sample data files (large)
scraper/data/san_diego_samples/
scraper/data/orange_county_samples/

# Checkpoint files (can be regenerated)
scraper/data/summary_checkpoint.json
scraper/data/summary_generation.log

# Local database backups
scraper/data/*.db.bak
scraper/data/ballot_measures_*.db

# Environment
.env
.env.local

# Logs
*.log
logs/

# Local planning docs (not for publication)
plans/
# Exception: docs/plans/ is for plans promoted for external review.
# NOTE: these negations also override .git/info/exclude entries, so a
# "private" file placed under docs/plans/ WILL be committed by git add -A.
# Private notes belong in plans/ (root), never in docs/plans/.
!docs/plans/
!docs/plans/**

# Reconnaissance scratch — raw fetched HTML/PDF/JSON from registrar
# sites. Not for git; can be huge. Phase 0.5 promotes the canonical
# store to Cloudflare R2.
scraper/data/registrar_recon/
