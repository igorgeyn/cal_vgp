@app.get("/measures", response_model=List[MeasureSummary], tags=["Measures"])
def list_measures(
    # Location
    county_fips: Optional[str]  = Query(None, description="5-digit FIPS e.g. '06001'"),
    county_name: Optional[str]  = Query(None, description="Partial match e.g. 'Los Angeles'"),
    statewide:   Optional[bool] = Query(None, description="True = statewide only"),
    # Domain
    domain:      Optional[str]  = Query(None, description="CAP topic e.g. 'Housing'"),
    cap_code:    Optional[int]  = Query(None, description="Exact CAP code e.g. 1300"),
    # Time
    year_from:   Optional[int]  = Query(None, ge=1911, le=2030),
    year_to:     Optional[int]  = Query(None, ge=1911, le=2030),
    # Outcome
    passed:      Optional[bool] = Query(None, description="True = passed, False = failed"),
    measure_type:Optional[str]  = Query(None, description="e.g. 'bond_measure'"),
    # Fiscal
    min_fiscal_impact: Optional[float] = Query(None, description="Min fiscal impact (2024 $)"),
    max_fiscal_impact: Optional[float] = Query(None, description="Max fiscal impact (2024 $)"),
    # Pagination
    limit:  int = Query(100, le=1000),
    offset: int = Query(0),
    db: Session = Depends(get_db),
):
    """
    Query ballot measures with flexible filters.
    For full detail on one measure use /measures/{measure_id}.
    """
    q = (
        db.query(BallotMeasure)
        .options(
            joinedload(BallotMeasure.county),
            joinedload(BallotMeasure.primary_topic),
            joinedload(BallotMeasure.outcomes),
            joinedload(BallotMeasure.finance),
        )
        .order_by(BallotMeasure.election_date.desc())
    )

    if county_fips:
        q = q.filter(BallotMeasure.county_fips == county_fips)
    if county_name:
        q = q.join(County, BallotMeasure.county_fips == County.county_fips)\
              .filter(County.county_name.ilike(f"%{county_name}%"))
    if statewide is not None:
        q = q.filter(BallotMeasure.statewide_flag == statewide)
    if domain:
        q = q.join(BallotMeasure.primary_topic)\
              .filter(CapTopic.cap_major.ilike(f"%{domain}%"))
    if cap_code:
        q = q.filter(BallotMeasure.cap_primary_code == cap_code)
    if year_from:
        q = q.filter(BallotMeasure.election_year >= year_from)
    if year_to:
        q = q.filter(BallotMeasure.election_year <= year_to)
    if measure_type:
        q = q.filter(BallotMeasure.measure_type == measure_type)
    if min_fiscal_impact is not None:
        q = q.filter(BallotMeasure.fiscal_impact_2024 >= min_fiscal_impact)
    if max_fiscal_impact is not None:
        q = q.filter(BallotMeasure.fiscal_impact_2024 <= max_fiscal_impact)
    if passed is not None:
        q = q.join(MeasureOutcome, and_(
            MeasureOutcome.measure_id == BallotMeasure.measure_id,
            MeasureOutcome.county_fips == None
        )).filter(MeasureOutcome.passed == passed)

    return [measure_to_dict(m) for m in q.offset(offset).limit(limit).all()]


