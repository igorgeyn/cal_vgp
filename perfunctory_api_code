def get_db():
    """
    Opens a database session for each API request, then closes it when done.
    FastAPI injects this automatically into every endpoint via Depends(get_db).
    """
    db = SessionLocal()
    try:
        yield db
    finally:
        db.close()


# ==============================================================================
# SECTION 2 — PYTHON ENUMS
# These define every allowed value for categorical fields.
# If you try to insert a value not in this list, Python raises an error
# before it even reaches the database — cleaner than a database constraint.
# ==============================================================================

class MeasureTypeEnum(str, enum.Enum):
    initiative_statute                  = "initiative_statute"
    initiative_constitutional_amendment = "initiative_constitutional_amendment"
    referendum_statutory                = "referendum_statutory"
    referendum_constitutional           = "referendum_constitutional"
    bond_measure                        = "bond_measure"
    charter_amendment                   = "charter_amendment"
    special_tax                         = "special_tax"
    advisory                            = "advisory"

class JurisdictionLevelEnum(str, enum.Enum):
    statewide        = "statewide"
    county           = "county"
    city             = "city"
    special_district = "special_district"
    school_district  = "school_district"

class ElectionTypeEnum(str, enum.Enum):
    primary      = "primary"
    general      = "general"
    special      = "special"
    consolidated = "consolidated"
    recall       = "recall"

class SponsorTypeEnum(str, enum.Enum):
    citizen_group   = "citizen_group"
    industry        = "industry"
    union           = "union"
    government      = "government"
    political_party = "political_party"
    nonprofit       = "nonprofit"
    mixed           = "mixed"
    unknown         = "unknown"

class FiscalMechanismEnum(str, enum.Enum):
    general_fund = "general_fund"
    special_fund = "special_fund"
    bond         = "bond"
    tax_increase = "tax_increase"
    tax_decrease = "tax_decrease"
    fee          = "fee"
    neutral      = "neutral"
    unknown      = "unknown"

class ImplementationStatusEnum(str, enum.Enum):
    implemented        = "implemented"
    enjoined           = "enjoined"
    partially_enjoined = "partially_enjoined"
    repealed           = "repealed"
    superseded         = "superseded"
    pending            = "pending"
    failed             = "failed"
    not_applicable     = "not_applicable"


# ==============================================================================
# SECTION 3 — DATABASE TABLES
# Each class = one database table.
# Each Column(...) = one column in that table.
# SQLAlchemy reads these classes and builds the actual database tables for you.
# ==============================================================================

class Base(DeclarativeBase):
    """All table classes must inherit from this. SQLAlchemy requires it."""
    pass


# ── TABLE 1: CAP TOPICS ───────────────────────────────────────────────────────
# The Comparative Agendas Project master codebook.
# Download the full codebook at: comparativeagendas.net
# This is the gold standard for policy topic classification in political science.
# Using CAP codes makes your data interoperable with decades of published research.

class CapTopic(Base):
    __tablename__ = "cap_topics"

    cap_code        = Column(Integer, primary_key=True)       # e.g. 1300 = Housing
    cap_major       = Column(String(100), nullable=False)     # e.g. "Housing"
    cap_minor       = Column(Integer)                         # subtopic code
    cap_minor_label = Column(String(200))                     # subtopic label
    notes           = Column(Text)

    primary_measures   = relationship("BallotMeasure", foreign_keys="BallotMeasure.cap_primary_code",   back_populates="primary_topic")
    secondary_measures = relationship("BallotMeasure", foreign_keys="BallotMeasure.cap_secondary_code", back_populates="secondary_topic")


# ── TABLE 2: COUNTIES ─────────────────────────────────────────────────────────
# All 58 California counties. Seeded automatically in Section 4.
# FIPS codes are the federal standard — they let you join to NHGIS census data
# and CAL-ACCESS campaign finance records without ambiguity.

class County(Base):
    __tablename__ = "counties"

    county_fips   = Column(String(5),   primary_key=True)     # e.g. "06001" = Alameda
    county_name   = Column(String(100), nullable=False)       # e.g. "Alameda"
    region        = Column(String(50))                        # e.g. "Bay Area"
    area_sq_miles = Column(Numeric(10, 2))
    created_at    = Column(DateTime, server_default=func.now())

    measures     = relationship("BallotMeasure",       back_populates="county")
    outcomes     = relationship("MeasureOutcome",      back_populates="county")
    demographics = relationship("CountyDemographic",   back_populates="county")
    profiles     = relationship("CountyDomainProfile", back_populates="county")


# ── TABLE 3: FISCAL ANALYSIS SOURCES ─────────────────────────────────────────
# Tracks where fiscal estimates came from. Quality varies enormously,
# especially pre-1970. Tag each estimate with its source and credibility score.

class FiscalAnalysisSource(Base):
    __tablename__ = "fiscal_analysis_sources"

    source_id     = Column(Integer, primary_key=True, autoincrement=True)
    source_name   = Column(String(200), nullable=False)       # e.g. "CA Legislative Analyst Office"
    source_abbrev = Column(String(20))                        # e.g. "LAO"
    credibility   = Column(SmallInteger)                      # 1 (low) to 5 (high)
    notes         = Column(Text)

    measures = relationship("BallotMeasure", back_populates="fiscal_source")


# ── TABLE 4: BALLOT MEASURES ← THE CORE TABLE ────────────────────────────────
# One row per ballot measure per jurisdiction.
# Every other table connects back to this one via measure_id.

class BallotMeasure(Base):
    __tablename__ = "ballot_measures"

    # Identity
    measure_id       = Column(Integer, primary_key=True, autoincrement=True)
    measure_uid      = Column(String(50), unique=True, nullable=False)  # e.g. "CA-1978-PROP13"
    measure_number   = Column(String(20))                               # e.g. "Prop 13"
    measure_title    = Column(Text, nullable=False)
    measure_text_url = Column(Text)                                     # Link to full text archive

    # Jurisdiction & Election
    jurisdiction_level    = Column(Enum(JurisdictionLevelEnum), nullable=False)
    county_fips           = Column(String(5), ForeignKey("counties.county_fips"))
    city_name             = Column(String(100))
    special_district_name = Column(String(200))
    election_date         = Column(Date, nullable=False)
    election_year         = Column(SmallInteger)             # Set in Python: election_date.year
    election_type         = Column(Enum(ElectionTypeEnum), nullable=False)
    consolidated_election = Column(Boolean, default=False)
    ballot_position       = Column(SmallInteger)             # Position on ballot — voter fatigue proxy
    statewide_flag        = Column(Boolean, default=False)

    # Measure Classification
    measure_type          = Column(Enum(MeasureTypeEnum), nullable=False)
    constitutional_change = Column(Boolean, default=False)
    reintroduction_flag   = Column(Boolean, default=False)   # Was this attempted before?
    prior_measure_id      = Column(Integer, ForeignKey("ballot_measures.measure_id"))
    morality_policy_flag  = Column(Boolean, default=False)   # Haider-Markel & Meier (1996)
    federal_alignment     = Column(String(20))               # "mirrors","contradicts","neutral","unknown"

    # Policy Domain (CAP codebook — see comparativeagendas.net)
    cap_primary_code   = Column(Integer, ForeignKey("cap_topics.cap_code"))
    cap_secondary_code = Column(Integer, ForeignKey("cap_topics.cap_code"))   # For hybrid measures
    domain_decade_norm = Column(Numeric(6, 4))               # Frequency normalized within decade

    # Fiscal Impact
    fiscal_mechanism       = Column(Enum(FiscalMechanismEnum))
    fiscal_impact_nominal  = Column(Numeric(15, 2))          # Raw dollar estimate at time of vote
    fiscal_impact_2024     = Column(Numeric(15, 2))          # CPI-adjusted to 2024 dollars
    per_household_cost     = Column(Numeric(10, 2))          # Normalized by county households
    bond_amount_nominal    = Column(Numeric(15, 2))
    bond_amount_2024       = Column(Numeric(15, 2))
    tax_rate_change_pct    = Column(Numeric(8, 4))
    fiscal_beneficiary     = Column(String(100))             # Who benefits
    fiscal_analysis_source = Column(Integer, ForeignKey("fiscal_analysis_sources.source_id"))
    fiscal_notes           = Column(Text)

    # Sponsorship (Gerber 1999 framework)
    sponsor_type          = Column(Enum(SponsorTypeEnum))
    sponsor_name          = Column(Text)
    sponsor_out_of_county = Column(Boolean)                  # Gerber outsider money flag
    petition_method       = Column(String(20))               # "paid","volunteer","mixed","n/a"

    # Legal History
    legal_challenge       = Column(Boolean, default=False)
    legal_outcome         = Column(String(100))
    implementation_status = Column(Enum(ImplementationStatusEnum),
                                   default=ImplementationStatusEnum.not_applicable)

    # Metadata
    data_source     = Column(String(200))
    data_confidence = Column(SmallInteger)                   # 1 (low) to 5 (high)
    notes           = Column(Text)
    created_at      = Column(DateTime, server_default=func.now())
    updated_at      = Column(DateTime, server_default=func.now(), onupdate=func.now())

    # Relationships — Python shortcuts between related tables
    county          = relationship("County",                foreign_keys=[county_fips],          back_populates="measures")
    primary_topic   = relationship("CapTopic",              foreign_keys=[cap_primary_code],     back_populates="primary_measures")
    secondary_topic = relationship("CapTopic",              foreign_keys=[cap_secondary_code],   back_populates="secondary_measures")
    fiscal_source   = relationship("FiscalAnalysisSource",  foreign_keys=[fiscal_analysis_source], back_populates="measures")
    prior_measure   = relationship("BallotMeasure",         remote_side="BallotMeasure.measure_id")
    outcomes        = relationship("MeasureOutcome",        back_populates="measure")
    finance         = relationship("CampaignFinance",       back_populates="measure", uselist=False)
    endorsements    = relationship("Endorsement",           back_populates="measure")


# ── TABLE 5: MEASURE OUTCOMES ─────────────────────────────────────────────────
# Vote counts and percentages. Separated from BallotMeasure so we can store
# both statewide totals AND county-level breakdowns for the same measure.
# A row with county_fips = NULL means the statewide total.

class MeasureOutcome(Base):
    __tablename__ = "measure_outcomes"
    __table_args__ = (
        UniqueConstraint("measure_id", "county_fips", name="uq_outcome_measure_county"),
    )

    outcome_id   = Column(Integer, primary_key=True, autoincrement=True)
    measure_id   = Column(Integer, ForeignKey("ballot_measures.measure_id"), nullable=False)
    county_fips  = Column(String(5), ForeignKey("counties.county_fips"))    # NULL = statewide

    # Vote totals
    yes_votes    = Column(Integer)
    no_votes     = Column(Integer)
    yes_pct      = Column(Numeric(6, 4))   # e.g. 0.6234 means 62.34%
    no_pct       = Column(Numeric(6, 4))
    passed       = Column(Boolean, nullable=False)
    margin_pct   = Column(Numeric(6, 4))   # yes_pct - 0.5  (positive = winning)

    # Turnout
    registered_voters    = Column(Integer)
    turnout_rate         = Column(Numeric(6, 4))
    roll_off_rate        = Column(Numeric(6, 4))    # Bowler, Donovan & Happ (1992) voter fatigue
    absentee_yes_pct     = Column(Numeric(6, 4))
    election_day_yes_pct = Column(Numeric(6, 4))

    # Geographic dispersion (precinct-level variance within county)
    precinct_yes_mean = Column(Numeric(6, 4))
    precinct_yes_sd   = Column(Numeric(6, 4))       # Standard deviation across precincts
    precinct_yes_gini = Column(Numeric(6, 4))       # Gini coefficient of precinct support

    # Ballot context
    measures_on_ballot = Column(SmallInteger)        # Total measures on this ballot
    ballot_rank_by_yes = Column(SmallInteger)        # Ranked by support vs. other measures

    created_at = Column(DateTime, server_default=func.now())

    measure = relationship("BallotMeasure", back_populates="outcomes")
    county  = relationship("County",        back_populates="outcomes")


# ── TABLE 6: CAMPAIGN FINANCE ─────────────────────────────────────────────────
# One row per measure. Both proponent and opposition spending.
# Methodology follows Gerber (1999) and Stratmann (2006).
# Pre-1974 data must be reconstructed — flag with pre_fppc_flag = True.

class CampaignFinance(Base):
    __tablename__ = "campaign_finance"

    finance_id = Column(Integer, primary_key=True, autoincrement=True)
    measure_id = Column(Integer, ForeignKey("ballot_measures.measure_id"), nullable=False)

    # Proponent (Yes) side
    yes_total_nominal     = Column(Numeric(15, 2))
    yes_total_2024        = Column(Numeric(15, 2))   # CPI-adjusted
    yes_pac_count         = Column(SmallInteger)
    yes_out_of_county_pct = Column(Numeric(6, 4))    # Gerber (1999) outsider money variable
    yes_union_pct         = Column(Numeric(6, 4))
    yes_corporate_pct     = Column(Numeric(6, 4))
    yes_citizen_pct       = Column(Numeric(6, 4))
    yes_top_donor         = Column(Text)
    yes_top_donor_amount  = Column(Numeric(15, 2))

    # Opposition (No) side
    no_total_nominal      = Column(Numeric(15, 2))
    no_total_2024         = Column(Numeric(15, 2))
    no_pac_count          = Column(SmallInteger)
    no_out_of_county_pct  = Column(Numeric(6, 4))
    no_union_pct          = Column(Numeric(6, 4))
    no_corporate_pct      = Column(Numeric(6, 4))
    no_citizen_pct        = Column(Numeric(6, 4))
    no_top_donor          = Column(Text)
    no_top_donor_amount   = Column(Numeric(15, 2))

    # Derived ratios — key predictors per Stratmann (2006)
    spending_ratio      = Column(Numeric(10, 4))     # yes_total / no_total
    spending_asymmetry  = Column(Numeric(15, 2))     # yes_total - no_total (2024 $)

    data_source    = Column(String(100))             # "CAL-ACCESS", "FPPC", "reconstructed"
    pre_fppc_flag  = Column(Boolean, default=False)  # Pre-1974 data quality flag
    notes          = Column(Text)
    created_at     = Column(DateTime, server_default=func.now())

    measure = relationship("BallotMeasure", back_populates="finance")


# ── TABLE 7: ENDORSEMENTS ─────────────────────────────────────────────────────
# Who publicly supported or opposed each measure.
# Grounds Lupia (1994) elite cue theory — voters use endorsements as shortcuts
# to make decisions without reading the full measure text.

class Endorsement(Base):
    __tablename__ = "endorsements"

    endorsement_id    = Column(Integer, primary_key=True, autoincrement=True)
    measure_id        = Column(Integer, ForeignKey("ballot_measures.measure_id"), nullable=False)
    position          = Column(String(10), nullable=False)    # "yes" or "no"
    endorser_type     = Column(String(50))                    # "newspaper","elected_official","org","union"
    endorser_name     = Column(Text, nullable=False)
    endorser_partisan = Column(String(20))                    # "dem","rep","nonpartisan","unknown"
    endorser_tier     = Column(SmallInteger)                  # 1 = major, 3 = minor
    created_at        = Column(DateTime, server_default=func.now())

    measure = relationship("BallotMeasure", back_populates="endorsements")


# ── TABLE 8: COUNTY DEMOGRAPHICS ─────────────────────────────────────────────
# Census snapshots by county. Join to measures using the nearest census year.
# Source: NHGIS (nhgis.org) — historical census data matched to county boundaries.
# IMPORTANT: Race/ethnicity categories changed significantly across census decades.

class CountyDemographic(Base):
    __tablename__ = "county_demographics"
    __table_args__ = (
        UniqueConstraint("county_fips", "census_year", name="uq_demo_county_year"),
    )

    demo_id     = Column(Integer, primary_key=True, autoincrement=True)
    county_fips = Column(String(5), ForeignKey("counties.county_fips"), nullable=False)
    census_year = Column(SmallInteger, nullable=False)        # 1920, 1930, ... 2020

    # Population
    total_population   = Column(Integer)
    population_density = Column(Numeric(10, 2))               # Per square mile
    urban_pct          = Column(Numeric(6, 4))
    median_age         = Column(Numeric(5, 2))

    # Race / Ethnicity (categories vary by census era — handle carefully)
    white_pct      = Column(Numeric(6, 4))
    black_pct      = Column(Numeric(6, 4))
    hispanic_pct   = Column(Numeric(6, 4))
    asian_pct      = Column(Numeric(6, 4))
    other_race_pct = Column(Numeric(6, 4))

    # Socioeconomic
    median_household_income = Column(Numeric(12, 2))
    median_income_2024      = Column(Numeric(12, 2))
    poverty_rate            = Column(Numeric(6, 4))
    unemployment_rate       = Column(Numeric(6, 4))
    college_edu_pct         = Column(Numeric(6, 4))           # % with bachelor's or higher
    homeownership_rate      = Column(Numeric(6, 4))
    median_home_value       = Column(Numeric(12, 2))
    median_home_value_2024  = Column(Numeric(12, 2))

    # Political registration
    registered_dem_pct   = Column(Numeric(6, 4))
    registered_rep_pct   = Column(Numeric(6, 4))
    registered_other_pct = Column(Numeric(6, 4))
    presidential_dem_pct = Column(Numeric(6, 4))              # Most recent presidential vote share

    total_households = Column(Integer)
    notes            = Column(Text)
    created_at       = Column(DateTime, server_default=func.now())

    county = relationship("County", back_populates="demographics")


# ── TABLE 9: COUNTY DOMAIN PROFILES ──────────────────────────────────────────
# Pre-aggregated rolling window statistics. The core unit for the R prediction model.
# Run compute_profiles() to populate this table after loading measure data.
# Inspired by Matsusaka (2004) fiscal federalism framing.

class CountyDomainProfile(Base):
    __tablename__ = "county_domain_profiles"
    __table_args__ = (
        UniqueConstraint("county_fips", "cap_primary_code", "window_end_year", "window_years",
                         name="uq_profile"),
    )

    profile_id       = Column(Integer, primary_key=True, autoincrement=True)
    county_fips      = Column(String(5), ForeignKey("counties.county_fips"), nullable=False)
    cap_primary_code = Column(Integer,   ForeignKey("cap_topics.cap_code"),  nullable=False)
    window_end_year  = Column(SmallInteger, nullable=False)
    window_years     = Column(SmallInteger, nullable=False)   # 5, 10, 15, or 20

    # Volume
    n_measures = Column(SmallInteger, nullable=False)
    n_passed   = Column(SmallInteger)
    n_failed   = Column(SmallInteger)
    pass_rate  = Column(Numeric(6, 4))

    # Margins
    median_margin_pct = Column(Numeric(6, 4))
    mean_yes_pct      = Column(Numeric(6, 4))
    margin_sd         = Column(Numeric(6, 4))

    # Finance
    median_yes_spend_2024 = Column(Numeric(15, 2))
    median_no_spend_2024  = Column(Numeric(15, 2))
    median_spending_ratio = Column(Numeric(10, 4))

    # Turnout
    mean_turnout_rate  = Column(Numeric(6, 4))
    mean_roll_off_rate = Column(Numeric(6, 4))

    computed_at = Column(DateTime, server_default=func.now())

    county = relationship("County",   back_populates="profiles")
    topic  = relationship("CapTopic")


# ── TABLE 10: STRUCTURAL BREAKS ───────────────────────────────────────────────
# Historical discontinuities that require segmented modeling.
# Pre/post these years should be modeled separately or flagged as covariates.
# Seeded automatically in Section 4.

class StructuralBreak(Base):
    __tablename__ = "structural_breaks"

    break_id          = Column(Integer, primary_key=True, autoincrement=True)
    break_year        = Column(SmallInteger, nullable=False)
    break_name        = Column(String(200),  nullable=False)
    break_description = Column(Text)
    affected_domains  = Column(ARRAY(Integer))               # Array of CAP codes affected
    scope             = Column(String(20))                   # "statewide","national","local"
    citation          = Column(Text)


