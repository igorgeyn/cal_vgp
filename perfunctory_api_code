@app.get("/counties/{county_fips}/summary", tags=["Counties"])
def get_county_summary(
    county_fips: str,
    year_from:   Optional[int] = Query(None),
    year_to:     Optional[int] = Query(None),
    db: Session = Depends(get_db),
):
    """
    Pass/fail counts by domain and year for one county.
    Use this to build historical timelines and charts.
    """
    if not db.query(County).filter(County.county_fips == county_fips).first():
        raise HTTPException(status_code=404, detail="County not found")

    q = (
        db.query(
            CapTopic.cap_major.label("domain"),
            BallotMeasure.election_year,
            func.count().label("n_measures"),
            func.sum(func.cast(MeasureOutcome.passed, Integer)).label("n_passed"),
            func.avg(MeasureOutcome.yes_pct).label("avg_yes_pct"),
            func.avg(MeasureOutcome.turnout_rate).label("avg_turnout"),
        )
        .join(CapTopic,       BallotMeasure.cap_primary_code == CapTopic.cap_code)
        .join(MeasureOutcome, and_(
            MeasureOutcome.measure_id == BallotMeasure.measure_id,
            MeasureOutcome.county_fips == None
        ))
        .filter(BallotMeasure.county_fips == county_fips)
    )
    if year_from: q = q.filter(BallotMeasure.election_year >= year_from)
    if year_to:   q = q.filter(BallotMeasure.election_year <= year_to)

    return [
        {"domain": r.domain, "year": r.election_year, "n_measures": r.n_measures,
         "n_passed": r.n_passed,
         "avg_yes_pct": round(float(r.avg_yes_pct), 4) if r.avg_yes_pct else None,
         "avg_turnout": round(float(r.avg_turnout),  4) if r.avg_turnout else None}
        for r in q.group_by(CapTopic.cap_major, BallotMeasure.election_year)
                   .order_by(BallotMeasure.election_year, CapTopic.cap_major).all()
    ]


@app.get("/counties/{county_fips}/profile", response_model=List[CountyProfileOut], tags=["Counties"])
def get_county_profile(
    county_fips:  str,
    window_years: int           = Query(10, description="5, 10, 15, or 20"),
    end_year:     Optional[int] = Query(None),
    domain:       Optional[str] = Query(None),
    db: Session = Depends(get_db),
):
    """
    Rolling-window domain statistics for a county.
    Primary input for the R prediction model.
    Shows pass rates, vote margins, spending ratios, and turnout
    over a defined time window.
    """
    if not db.query(County).filter(County.county_fips == county_fips).first():
        raise HTTPException(status_code=404, detail="County not found")

    q = (
        db.query(CountyDomainProfile, CapTopic.cap_major.label("domain"), County.county_name)
        .join(CapTopic, CountyDomainProfile.cap_primary_code == CapTopic.cap_code)
        .join(County,   CountyDomainProfile.county_fips == County.county_fips)
        .filter(CountyDomainProfile.county_fips == county_fips,
                CountyDomainProfile.window_years == window_years)
    )
    if end_year: q = q.filter(CountyDomainProfile.window_end_year == end_year)
    if domain:   q = q.filter(CapTopic.cap_major.ilike(f"%{domain}%"))

    results = q.order_by(CapTopic.cap_major, CountyDomainProfile.window_end_year).all()
    if not results:
        raise HTTPException(status_code=404,
            detail="No profile data. Run compute_profiles() after loading measure data.")

    return [
        {
            "county_fips":           r.CountyDomainProfile.county_fips,
            "county_name":           r.county_name,
            "domain":                r.domain,
            "window_end_year":       r.CountyDomainProfile.window_end_year,
            "window_years":          r.CountyDomainProfile.window_years,
            "n_measures":            r.CountyDomainProfile.n_measures,
            "n_passed":              r.CountyDomainProfile.n_passed,
            "n_failed":              r.CountyDomainProfile.n_failed,
            "pass_rate":             float(r.CountyDomainProfile.pass_rate)             if r.CountyDomainProfile.pass_rate             else None,
            "median_margin_pct":     float(r.CountyDomainProfile.median_margin_pct)     if r.CountyDomainProfile.median_margin_pct     else None,
            "mean_yes_pct":          float(r.CountyDomainProfile.mean_yes_pct)          if r.CountyDomainProfile.mean_yes_pct          else None,
            "mean_turnout_rate":     float(r.CountyDomainProfile.mean_turnout_rate)     if r.CountyDomainProfile.mean_turnout_rate     else None,
            "median_spending_ratio": float(r.CountyDomainProfile.median_spending_ratio) if r.CountyDomainProfile.median_spending_ratio else None,
        }
        for r in results
    ]


@app.get("/counties/{county_fips}/demographics", tags=["Counties"])
def get_county_demographics(
    county_fips: str,
    census_year: Optional[int] = Query(None, description="e.g. 2020"),
    db: Session = Depends(get_db),
):
    """
    Census demographic snapshots for a county.
    Source: NHGIS (nhgis.org) — historical census matched to county boundaries.
    Note: Race/ethnicity categories changed significantly across census decades.
    """
    q = db.query(CountyDemographic).filter(CountyDemographic.county_fips == county_fips)
    if census_year:
        q = q.filter(CountyDemographic.census_year == census_year)
    results = q.order_by(CountyDemographic.census_year).all()
    if not results:
        raise HTTPException(status_code=404, detail="No demographic data for this county")
    return [
        {"census_year": r.census_year, "total_population": r.total_population,
         "urban_pct":            float(r.urban_pct)            if r.urban_pct            else None,
         "median_income_2024":   float(r.median_income_2024)   if r.median_income_2024   else None,
         "college_edu_pct":      float(r.college_edu_pct)      if r.college_edu_pct      else None,
         "homeownership_rate":   float(r.homeownership_rate)   if r.homeownership_rate   else None,
         "registered_dem_pct":   float(r.registered_dem_pct)   if r.registered_dem_pct   else None,
         "registered_rep_pct":   float(r.registered_rep_pct)   if r.registered_rep_pct   else None,
         "presidential_dem_pct": float(r.presidential_dem_pct) if r.presidential_dem_pct else None,
         "poverty_rate":         float(r.poverty_rate)         if r.poverty_rate         else None,
         "unemployment_rate":    float(r.unemployment_rate)    if r.unemployment_rate    else None}
        for r in results
    ]


# ── ANALYSIS ──────────────────────────────────────────────────────────────────

@app.get("/compare", tags=["Analysis"])
def compare_counties(
    county_fips: List[str] = Query(..., description="2+ FIPS codes e.g. 06001&county_fips=06075"),
    domain:      str       = Query(..., description="CAP topic e.g. 'Housing'"),
    year_from:   int       = Query(1970),
    year_to:     int       = Query(2024),
    db: Session = Depends(get_db),
):
    """
    Compare pass rates, spending ratios, and turnout across multiple counties
    for a given domain and time range.
    """
    results = (
        db.query(
            County.county_name,
            CapTopic.cap_major.label("domain"),
            func.count().label("n_measures"),
            func.avg(MeasureOutcome.yes_pct).label("avg_yes_pct"),
            func.sum(func.cast(MeasureOutcome.passed, Integer)).label("n_passed"),
            func.avg(MeasureOutcome.turnout_rate).label("avg_turnout"),
            func.avg(CampaignFinance.spending_ratio).label("avg_spending_ratio"),
        )
        .join(County,         BallotMeasure.county_fips == County.county_fips)
        .join(CapTopic,       BallotMeasure.cap_primary_code == CapTopic.cap_code)
        .join(MeasureOutcome, and_(MeasureOutcome.measure_id == BallotMeasure.measure_id,
                                   MeasureOutcome.county_fips == None))
        .outerjoin(CampaignFinance, CampaignFinance.measure_id == BallotMeasure.measure_id)
        .filter(BallotMeasure.county_fips.in_(county_fips),
                CapTopic.cap_major.ilike(f"%{domain}%"),
                BallotMeasure.election_year.between(year_from, year_to))
        .group_by(County.county_name, CapTopic.cap_major)
        .order_by(func.avg(MeasureOutcome.yes_pct).desc())
        .all()
    )
    return [
        {"county_name": r.county_name, "domain": r.domain,
         "n_measures": r.n_measures, "n_passed": r.n_passed,
         "avg_yes_pct":        round(float(r.avg_yes_pct),        4) if r.avg_yes_pct        else None,
         "avg_turnout":        round(float(r.avg_turnout),         4) if r.avg_turnout         else None,
         "avg_spending_ratio": round(float(r.avg_spending_ratio),  4) if r.avg_spending_ratio  else None}
        for r in results
    ]


