def run_setup():
    """Creates all tables, adds indexes, and seeds reference data. Run once."""

    print("\n=== California Ballot Measures — Database Setup ===\n")

    # Step 1: Create all tables from the classes defined in Section 3
    print("Creating tables...")
    Base.metadata.create_all(engine)

    # Step 2: Add query performance indexes
    print("Adding indexes...")
    with engine.connect() as conn:
        for idx_sql in [
            "CREATE INDEX IF NOT EXISTS idx_measures_county      ON ballot_measures(county_fips)",
            "CREATE INDEX IF NOT EXISTS idx_measures_year        ON ballot_measures(election_year)",
            "CREATE INDEX IF NOT EXISTS idx_measures_cap         ON ballot_measures(cap_primary_code)",
            "CREATE INDEX IF NOT EXISTS idx_measures_county_year ON ballot_measures(county_fips, election_year)",
            "CREATE INDEX IF NOT EXISTS idx_measures_domain_year ON ballot_measures(cap_primary_code, election_year)",
            "CREATE INDEX IF NOT EXISTS idx_outcomes_measure     ON measure_outcomes(measure_id)",
            "CREATE INDEX IF NOT EXISTS idx_outcomes_county      ON measure_outcomes(county_fips)",
            "CREATE INDEX IF NOT EXISTS idx_profiles_county      ON county_domain_profiles(county_fips, cap_primary_code)",
            "CREATE INDEX IF NOT EXISTS idx_demo_county_year     ON county_demographics(county_fips, census_year)",
        ]:
            conn.execute(text(idx_sql))
        conn.commit()

    # Step 3: Seed reference data
    db = SessionLocal()
    try:
        # Counties
        existing_fips = {c.county_fips for c in db.query(County).all()}
        new_counties = [
            County(county_fips=fips, county_name=name, region=region)
            for fips, name, region in CALIFORNIA_COUNTIES
            if fips not in existing_fips
        ]
        if new_counties:
            db.add_all(new_counties)
            db.commit()
            print(f"  Seeded {len(new_counties)} counties.")

        # CAP topics
        existing_codes = {t.cap_code for t in db.query(CapTopic).all()}
        new_topics = [
            CapTopic(cap_code=code, cap_major=major)
            for code, major in CAP_TOPICS
            if code not in existing_codes
        ]
        if new_topics:
            db.add_all(new_topics)
            db.commit()
            print(f"  Seeded {len(new_topics)} CAP topic codes.")

        # Structural breaks
        existing_years = {b.break_year for b in db.query(StructuralBreak).all()}
        new_breaks = [
            StructuralBreak(break_year=year, break_name=name, break_description=desc,
                            affected_domains=domains, scope=scope, citation=citation)
            for year, name, desc, domains, scope, citation in STRUCTURAL_BREAKS
            if year not in existing_years
        ]
        if new_breaks:
            db.add_all(new_breaks)
            db.commit()
            print(f"  Seeded {len(new_breaks)} structural breaks.")

        # Fiscal sources
        if db.query(FiscalAnalysisSource).count() == 0:
            db.add_all([
                FiscalAnalysisSource(source_name=n, source_abbrev=a, credibility=c, notes=notes)
                for n, a, c, notes in FISCAL_SOURCES
            ])
            db.commit()
            print(f"  Seeded {len(FISCAL_SOURCES)} fiscal analysis sources.")

    finally:
        db.close()

    print("\nSetup complete.")
    print("Now run:  python ca_ballot_api.py")
    print("Then open: http://localhost:8000/docs\n")


