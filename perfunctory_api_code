def measure_to_dict(m: BallotMeasure) -> dict:
    """
    Flatten a BallotMeasure ORM object and all its related tables into one dict.
    The statewide outcome is the row in measure_outcomes where county_fips is None.
    """
    statewide = next((o for o in m.outcomes if o.county_fips is None), None)
    finance   = m.finance
    return {
        "measure_id":            m.measure_id,
        "measure_uid":           m.measure_uid,
        "measure_number":        m.measure_number,
        "measure_title":         m.measure_title,
        "election_date":         m.election_date,
        "election_year":         m.election_year,
        "county_name":           m.county.county_name       if m.county         else None,
        "region":                m.county.region             if m.county         else None,
        "measure_type":          m.measure_type.value        if m.measure_type   else None,
        "jurisdiction_level":    m.jurisdiction_level.value  if m.jurisdiction_level else None,
        "primary_domain":        m.primary_topic.cap_major   if m.primary_topic  else None,
        "secondary_domain":      m.secondary_topic.cap_major if m.secondary_topic else None,
        "constitutional_change": m.constitutional_change,
        "reintroduction_flag":   m.reintroduction_flag,
        "morality_policy_flag":  m.morality_policy_flag,
        "federal_alignment":     m.federal_alignment,
        "fiscal_mechanism":      m.fiscal_mechanism.value    if m.fiscal_mechanism else None,
        "fiscal_impact_2024":    float(m.fiscal_impact_2024)  if m.fiscal_impact_2024  else None,
        "per_household_cost":    float(m.per_household_cost)  if m.per_household_cost  else None,
        "bond_amount_2024":      float(m.bond_amount_2024)    if m.bond_amount_2024    else None,
        "sponsor_type":          m.sponsor_type.value          if m.sponsor_type        else None,
        "sponsor_name":          m.sponsor_name,
        "legal_challenge":       m.legal_challenge,
        "implementation_status": m.implementation_status.value if m.implementation_status else None,
        "passed":                statewide.passed                                        if statewide else None,
        "yes_pct":               float(statewide.yes_pct)       if statewide and statewide.yes_pct       else None,
        "margin_pct":            float(statewide.margin_pct)    if statewide and statewide.margin_pct    else None,
        "turnout_rate":          float(statewide.turnout_rate)  if statewide and statewide.turnout_rate  else None,
        "roll_off_rate":         float(statewide.roll_off_rate) if statewide and statewide.roll_off_rate else None,
        "yes_total_2024":        float(finance.yes_total_2024)  if finance and finance.yes_total_2024    else None,
        "no_total_2024":         float(finance.no_total_2024)   if finance and finance.no_total_2024     else None,
        "spending_ratio":        float(finance.spending_ratio)  if finance and finance.spending_ratio    else None,
        "data_source":           m.data_source,
        "data_confidence":       m.data_confidence,
        "notes":                 m.notes,
    }


