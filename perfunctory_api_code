@app.get("/predict", response_model=PredictionResult, tags=["Prediction"])
def predict_measure_probability(
    county_fips:   str = Query(..., description="5-digit FIPS code"),
    domain:        str = Query(..., description="CAP topic e.g. 'Housing'"),
    horizon_years: int = Query(10, ge=1, le=30, description="Forecast horizon in years"),
    db: Session = Depends(get_db),
):
    """
    Predict: in county X, how likely is a ballot measure on domain Z
    in the next T years, and what is the estimated passage probability?

    **Formula:** joint_probability = P(measure occurs) × P(passes | occurs)

    **To connect your R model**, replace the STUB section with:

        result = subprocess.run(
            ["Rscript", "model.R", county_fips, domain, str(horizon_years)],
            capture_output=True, text=True
        )
        return json.loads(result.stdout)

    Your R script should write one JSON object to stdout:
        {"predicted_n_measures": 3.2, "predicted_pass_probability": 0.61, "joint_probability": 0.49}
    """
    county = db.query(County).filter(County.county_fips == county_fips).first()
    if not county:
        raise HTTPException(status_code=404, detail="County not found")

    profile = (
        db.query(CountyDomainProfile)
        .join(CapTopic, CountyDomainProfile.cap_primary_code == CapTopic.cap_code)
        .filter(CountyDomainProfile.county_fips == county_fips,
                CapTopic.cap_major.ilike(f"%{domain}%"),
                CountyDomainProfile.window_years == 10)
        .order_by(CountyDomainProfile.window_end_year.desc())
        .first()
    )
    if not profile:
        raise HTTPException(status_code=404,
            detail="No 10-year profile found. Load measure data and run compute_profiles() first.")

    # ── STUB: replace this with subprocess.run(["Rscript", "model.R", ...]) ──
    annual_rate = profile.n_measures / 10.0
    predicted_n = annual_rate * horizon_years
    pass_prob   = float(profile.pass_rate) if profile.pass_rate else 0.5
    joint_prob  = min(1.0, predicted_n / horizon_years) * pass_prob
    # ─────────────────────────────────────────────────────────────────────────

    return {
        "county_fips":                county_fips,
        "county_name":                county.county_name,
        "domain":                     domain,
        "horizon_years":              horizon_years,
        "predicted_n_measures":       round(predicted_n, 2),
        "predicted_pass_probability": round(pass_prob, 4),
        "joint_probability":          round(joint_prob, 4),
        "confidence_note":            "Heuristic stub — replace with brms model for credible intervals.",
    }


